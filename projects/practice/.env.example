# Copy to  projects/practice/.env  and fill in. NEVER commit the real .env.
#
# Unit tests run without any of these. Live/integration tests run only when
# LLM_LIVE=1 AND the relevant key is present.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...            # optional, only for the "voyage" embedder

# --- optional overrides ---
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# LAB_USD_CAP=0.25                 # hard per-run spend cap; a call that crosses it raises
# LLM_LIVE=1                       # set to run the live tests / notebooks against real APIs
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=4
